{
  "name": "i18n-speed",
  "displayName": "I18n Speed",
  "description": "",
  "version": "0.0.3",
  "keywords": [
    "i18n"
  ],
  "publisher": "findxc",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:html",
    "onLanguage:typescript"
  ],
 "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "i18n-speed.insert",
        "title": "i18n: Insert"
      },
      {
        "command": "i18n-speed.insertForceHashKey",
        "title": "i18n: Insert (force hash key)"
      },
      {
        "command": "i18n-speed.insertFromClipboard",
        "title": "i18n: Insert From Clipboard"
      },
      {
        "command": "i18n-speed.insertFromSelections",
        "title": "i18n: Insert From Selections"
      }
    ],
    "keybindings": [
      {
        "command": "i18n-speed.insert",
        "key": "ctrl+1",
        "mac": "cmd+1"
      },
      {
        "command": "i18n-speed.insertForceHashKey",
        "key": "ctrl+2",
        "mac": "cmd+2"
      }
    ],
    "configuration": [
      {
        "title": "I18n Speed",
        "properties": {
          "i18n-speed.i18nGlobalFilesDir": {
            "order": 1,
            "type": "string",
            "default": "src/i18n",
            "description": ""
          },
          "i18n-speed.i18nFileNamingStyle": {
            "order": 11,
            "type": "string",
            "enum": [
              "camelCase",
              "kebabCase",
              "snakeCase",
              "upperSnakeCase"
            ],
            "markdownEnumDescriptions": [
              "fooBar",
              "foo-bar",
              "foo_bar",
              "FOO_BAR"
            ],
            "default": "camelCase"
          },
          "i18n-speed.i18nNamespaceNamingStyle": {
            "order": 12,
            "type": "string",
            "enum": [
              "camelCase",
              "kebabCase",
              "snakeCase",
              "upperSnakeCase"
            ],
            "markdownEnumDescriptions": [
              "fooBar",
              "foo-bar",
              "foo_bar",
              "FOO_BAR"
            ],
            "default": "camelCase"
          },
          "i18n-speed.i18nKeyNamingStyle": {
            "order": 13,
            "type": "string",
            "enum": [
              "hash",
              "camelCase",
              "kebabCase",
              "snakeCase",
              "upperSnakeCase"
            ],
            "markdownEnumDescriptions": [
              "random 4 characters, e.g. `gpxu`",
              "fooBar",
              "foo-bar",
              "foo_bar",
              "FOO_BAR"
            ],
            "default": "camelCase"
          }
        }
      }
    ]
  },
  "scripts": {
   "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.17",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "esbuild": "^0.25.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  }
}
