{
  "name": "i18n-speed",
  "displayName": "I18n Speed",
  "description": "",
  "version": "0.0.3",
  "keywords": [
    "i18n"
  ],
  "publisher": "findxc",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:html",
    "onLanguage:typescript"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "i18n-speed.selectStringsNeedI18n",
        "title": "i18n: Select Strings Need I18n"
      },
      {
        "command": "i18n-speed.insert",
        "title": "i18n: Insert"
      },
      {
        "command": "i18n-speed.insertForceHashKey",
        "title": "i18n: Insert (force hash key)"
      },
      {
        "command": "i18n-speed.insertFromClipboard",
        "title": "i18n: Insert From Clipboard"
      },
      {
        "command": "i18n-speed.insertFromSelections",
        "title": "i18n: Insert From Selections"
      }
    ],
    "keybindings": [
      {
        "command": "i18n-speed.selectStringsNeedI18n",
        "key": "ctrl+1",
        "mac": "cmd+1"
      },
      {
        "command": "i18n-speed.insert",
        "key": "ctrl+2",
        "mac": "cmd+2"
      },
      {
        "command": "i18n-speed.insertForceHashKey",
        "key": "ctrl+3",
        "mac": "cmd+3"
      }
    ],
    "configuration": [
      {
        "title": "I18n Speed",
        "properties": {
          "i18n-speed.i18nGlobalFilesDir": {
            "order": 1,
            "type": "string",
            "default": "src/i18n",
            "description": ""
          },
          "i18n-speed.i18nFileNamingStyle": {
            "order": 11,
            "type": "string",
            "enum": [
              "camelCase",
              "kebabCase",
              "snakeCase",
              "upperSnakeCase"
            ],
            "markdownEnumDescriptions": [
              "fooBar",
              "foo-bar",
              "foo_bar",
              "FOO_BAR"
            ],
            "default": "camelCase"
          },
          "i18n-speed.i18nNamespaceNamingStyle": {
            "order": 12,
            "type": "string",
            "enum": [
              "camelCase",
              "kebabCase",
              "snakeCase",
              "upperSnakeCase"
            ],
            "markdownEnumDescriptions": [
              "fooBar",
              "foo-bar",
              "foo_bar",
              "FOO_BAR"
            ],
            "default": "camelCase"
          },
          "i18n-speed.i18nKeyNamingStyle": {
            "order": 13,
            "type": "string",
            "enum": [
              "hash",
              "camelCase",
              "kebabCase",
              "snakeCase",
              "upperSnakeCase"
            ],
            "markdownEnumDescriptions": [
              "random 4 characters, e.g. `gpxu`",
              "fooBar",
              "foo-bar",
              "foo_bar",
              "FOO_BAR"
            ],
            "default": "camelCase"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.17",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "copy-webpack-plugin": "^13.0.0",
    "eslint": "^9.25.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  }
}
